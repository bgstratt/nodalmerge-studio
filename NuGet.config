<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- NodalMerge.* packages are consumed from nuget.org (0.2.3+ published there).
         To test an UNRELEASED NodalMerge.* build locally, use
         scripts/restore-local-nodalmerge.ps1, which injects a local feed at restore
         time via RestoreAdditionalProjectSources — no edit to this file needed. -->

  </packageSources>
</configuration>
