<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- NodalMerge.* pre-publish packages come from the sibling nodalmerge
         checkout's pack output (hosts/dotnet/pack-local-nuget.ps1 -Version x.y.z).
         Relative path assumes the standard side-by-side repo layout — the same
         one NodalMergeUseNuGetPackages=false project references assume. Before
         this entry existed, restore silently depended on whatever version
         happened to sit in the global package cache (the repack footgun).
         Forward slashes: NuGet normalizes them on Windows, but a backslash is a
         literal filename char on Linux (CI), where "..\nodalmerge\..." would be one
         nonexistent path segment and restore fails NU1301. -->
    <add key="nodalmerge-local" value="../nodalmerge/artifacts/nuget-local" />
  </packageSources>
</configuration>
