<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NodalMerge.Studio.Storage</RootNamespace>
    <AssemblyName>NodalMerge.Studio.Storage</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup Condition="'$(NodalMergeUseNuGetPackages)' == 'true'">
    <PackageReference Include="NodalMerge.Host.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(NodalMergeUseNuGetPackages)' != 'true' AND Exists('$(NodalMergeDotNetHostProject)')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\nodalmerge\hosts\dotnet\src\NodalMerge.Host.Abstractions\NodalMerge.Host.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NodalMerge.Studio.Core\NodalMerge.Studio.Core.csproj" />
  </ItemGroup>

</Project>
